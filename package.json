{
  "name": "budget-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @budget/frontend dev",
    "pb:install": "./scripts/fetch-pocketbase.sh",
    "mailpit:install": "./scripts/fetch-mailpit.sh",
    "services:install": "pnpm pb:install && pnpm mailpit:install",
    "mailpit:dev": "./bin/mailpit --listen=127.0.0.1:8025 --smtp=127.0.0.1:1025 --smtp-auth-accept-any --smtp-auth-allow-insecure",
    "pb:dev": "./bin/pocketbase serve --dev --dir=pb_data --migrationsDir=pb_migrations --hooksDir=pb_hooks --publicDir=pb_public",
    "domain:build": "pnpm --filter @budget/domain build",
    "build": "pnpm domain:build && pnpm --filter @budget/frontend build",
    "pretest": "pnpm domain:build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:domain": "vitest run --project domain",
    "test:journeys": "vitest run --project journeys"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
